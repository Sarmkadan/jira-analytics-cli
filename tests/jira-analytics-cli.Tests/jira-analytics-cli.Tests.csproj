<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Required for build-time IDE0005 (unused usings) under EnforceCodeStyleInBuild -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Test project compiles a subset of sources; shared Models/TrendAnalysis.cs crefs to IssueCycleTime (not included here) are false positives -->
    <NoWarn>$(NoWarn);CS1574</NoWarn>
    <RootNamespace>JiraAnalyticsCli</RootNamespace>
    <Version>2.0.2</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

